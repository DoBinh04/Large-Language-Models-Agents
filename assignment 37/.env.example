# Copy thành ".env". (Nếu thiếu, script tự đọc thêm .env của assignment 32 / 33.)
ANTHROPIC_API_KEY=

# Langfuse: bỏ trống -> chỉ ghi log JSONL cục bộ + dashboard.html
# Cloud (miễn phí, đỡ tốn RAM):  https://cloud.langfuse.com  (EU) hoặc https://us.cloud.langfuse.com
# Self-host (docker compose):    http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# SDK mới đọc LANGFUSE_BASE_URL; code tự đồng bộ hai biến nên chỉ cần điền một
# LANGFUSE_BASE_URL=

# Số ký tự tối đa của input/output khi ghi log cục bộ
# OBS_MAX_FIELD_CHARS=4000
