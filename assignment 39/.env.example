# Copy thành .env rồi điền key được cấp
ANTHROPIC_API_KEY=sk-ant-...

# Baseline "API LLM" (thay gpt-oss-120b @ medium reasoning)
BASE_MODEL=claude-opus-5-5
BASE_EFFORT=medium

# LLM Judge
JUDGE_MODEL=claude-opus-5-5
JUDGE_EFFORT=low

# 1 = bật server-side fallback khi model từ chối (Opus / Sonnet)
USE_FALLBACKS=1

# Small LLM cho router + giá GPU tự host (USD/giờ) để quy đổi chi phí
SMALL_BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
GPU_COST_PER_HOUR=0.35

# 1 = RAG chỉ dùng BM25 (máy yếu, không tải embedding / reranker)
RAG_LIGHT=0

# Query rewrite trước khi search RAG: off | rules (mặc định, không tốn API) | llm (rules + Claude viết lại)
QUERY_REWRITE=rules
REWRITE_MODEL=claude-haiku-5-5
REWRITE_EFFORT=low

# Structured logging: text (local) | json (Docker / log collector). LOG_FILE tuỳ chọn, luôn ghi JSON.
LOG_FORMAT=text
LOG_LEVEL=INFO
# LOG_FILE=results/logs/app.jsonl

# FastAPI (python -m api.main)
API_ROUTER=api
API_TOOLS=local
SESSION_TTL_S=3600
MAX_SESSIONS=500
# CORS_ORIGINS=http://localhost:8501
# ADMIN_TOKEN=doi-thanh-chuoi-bi-mat     # bật POST /admin/reset-data

# Streamlit -> FastAPI
API_URL=http://localhost:8000
